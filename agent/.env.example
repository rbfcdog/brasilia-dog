PORT=3001
AGENT_SERVICE_TOKEN=replace-with-a-long-random-secret
OPENAI_API_KEY=replace-in-your-runtime-only
OPENAI_MODEL=gpt-5.4-mini
ADAPTER_MODE=demo

# Required for persisted conversation context in demo mode.
# Required for all backend calls in HTTP mode.
# Set this to the API service's AGENT_SERVICE_TOKEN, not this service's AGENT_SERVICE_TOKEN.
BACKEND_BASE_URL=https://api.example.com
AGENT_BACKEND_TOKEN=replace-with-the-api-agent-service-token
