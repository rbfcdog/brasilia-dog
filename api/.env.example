# Sandbox only. Do not put live credentials here until Stripe has activated
# the account and the team has completed the live-money gates in docs/.
PORT=3000
STRIPE_MODE=sandbox
STRIPE_SECRET_KEY=sk_test_replace_locally
STRIPE_PROFILE_ID=profile_test_replace_locally
MPP_SECRET_KEY=replace_with_at_least_32_random_bytes

# Required. Generate once with: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
# Keep stable across restarts so authenticated passkey sessions remain verifiable.
SESSION_SECRET=replace_with_64_random_hex_characters

# Supabase is optional until the database-backed catalog is enabled.
# This URL is not a secret.
SUPABASE_URL=https://your-project-ref.supabase.co

# Server-only payment and audit authority. This key bypasses RLS.
# Never expose it to browser code, agents, logs, or Git.
SUPABASE_SECRET_KEY=sb_secret_replace_locally

# Public key used by the frontend for Merchant Auth and RLS projection reads.
# The Node API validates each caller JWT before using its server-only client for
# allowlisted commands; never send the server key to the browser.
SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_locally

DATABASE_URL=postgresql://postgres:<pass>@db.<url>:5432/postgres?sslmode=require

# WebAuthn/passkey relying party configuration.
# In production, set these to your real domain.
PASSKEY_RP_NAME=Brasilia Dog Marketplace
PASSKEY_RP_ID=localhost
PASSKEY_ORIGIN=http://localhost:5173

# Optional. The API validates this token before allowing the agent service
# to read persisted conversation history. Set the agent service's
# AGENT_BACKEND_TOKEN to this same value.
# Generate with: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
AGENT_SERVICE_TOKEN=replace_with_64_random_hex_characters
