# Server-only URL for the Node backend in ../api. Use the deployed api service URL in production.
BACKEND_API_URL=http://localhost:3000

# Server-only agent service URL and BFF credential. Never prefix these with NEXT_PUBLIC_.
#
# AGENT_SERVICE_TOKEN here must equal the AGENT SERVICE's own AGENT_SERVICE_TOKEN
# (the secret the agent accepts). It is NOT the api service's inbound
# AGENT_SERVICE_TOKEN: that value (agent/.env AGENT_BACKEND_TOKEN) authorizes
# agent -> api calls and will be rejected with 401 by the agent service.
AGENT_SERVICE_URL=http://localhost:3001
AGENT_SERVICE_TOKEN=replace-with-the-agent-services-own-agent-service-token
