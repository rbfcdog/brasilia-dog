# Server-only URL for the Node backend in ../api. Use the deployed api service URL in production.
BACKEND_API_URL=http://localhost:3000

# Server-only agent service URL and BFF credential. Never prefix these with NEXT_PUBLIC_.
AGENT_SERVICE_URL=http://localhost:3001
AGENT_SERVICE_TOKEN=replace-with-the-agent-service-token

# Public Supabase configuration for Merchant authentication and RLS-scoped projections.
# These are safe browser credentials. Never put SUPABASE_SECRET_KEY here.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_locally

# Merchant demo access. It is enabled by default during `npm run dev`.
# Set true explicitly in the hackathon deployment to show the no-login demo button.
# Keep false in any environment that uses real merchant data or Supabase authentication.
NEXT_PUBLIC_MERCHANT_MOCK_AUTH=true
