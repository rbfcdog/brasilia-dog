# Copy to .env and fill OPENAI_API_KEY. The devcontainer does this automatically
# on first open, then injects this file into the container environment.
#
# This file is read by `docker run --env-file`, which does NOT support quotes,
# spaces around `=`, or ${VAR} expansion. Write bare values only.
#
# PORT is deliberately absent: the three services need different ports, so each
# one is set per task in .vscode/tasks.json.

# ---- Required -------------------------------------------------------------
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini

# ---- Agent ----------------------------------------------------------------
# demo = agent runs standalone. Switch to http to exercise the real api calls.
ADAPTER_MODE=demo
BACKEND_BASE_URL=http://localhost:3000

# Both names must hold the same value locally: the api validates incoming agent
# calls against AGENT_SERVICE_TOKEN, and the agent presents AGENT_BACKEND_TOKEN.
# Minimum 16 characters.
AGENT_SERVICE_TOKEN=local-dev-shared-agent-token
AGENT_BACKEND_TOKEN=local-dev-shared-agent-token

# ---- API: payments (sandbox placeholders are enough for the mocked flow) ---
STRIPE_MODE=sandbox
STRIPE_SECRET_KEY=sk_test_local_dev_only
STRIPE_PROFILE_ID=profile_test_local_dev_only
MPP_SECRET_KEY=local-dev-mpp-secret-at-least-32-bytes-long
SESSION_SECRET=local-dev-session-secret-at-least-32-chars

# ---- API: passkey / WebAuthn ----------------------------------------------
# Origin must match where the frontend is served (task Dev: front uses 3002).
PASSKEY_RP_NAME=Brasilia Dog
PASSKEY_RP_ID=localhost
PASSKEY_ORIGIN=http://localhost:3002

# ---- Supabase (optional) --------------------------------------------------
# Leave all empty to run self-contained with in-memory fixtures.
# Populate together to exercise the database-backed repositories.
SUPABASE_URL=
SUPABASE_SECRET_KEY=
SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# ---- Frontend -------------------------------------------------------------
NEXT_PUBLIC_MERCHANT_MOCK_AUTH=true
BACKEND_API_URL=http://localhost:3000
AGENT_SERVICE_URL=http://localhost:3001
